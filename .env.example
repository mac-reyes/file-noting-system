# Copy to .env and fill in real values locally.
# Never commit .env.
#
# Add one variable per credential you need to recreate in n8n web.
# Keep names generic enough to be safe to share.

# n8n public API deployment
N8N_BASE_URL=
N8N_API_KEY=

# Optional workflow IDs for npm run get/deploy.
# You can also put these in ignored workflows/<slug>/local.json.
WORKFLOW_CLAIMS_ASSESSMENT_LEGAL_REVIEW_ID=
WORKFLOW_MICROSOFT_GRAPH_MAIL_SUBSCRIPTION_MANAGER_ID=

# HTTP Request node: generic OAuth2 credential
HTTP_OAUTH2_CLIENT_ID=
HTTP_OAUTH2_CLIENT_SECRET=
HTTP_OAUTH2_AUTH_URL=
HTTP_OAUTH2_TOKEN_URL=
HTTP_OAUTH2_SCOPE=

# Google Sheets nodes: Google Sheets OAuth2 credential
GOOGLE_SHEETS_CLIENT_ID=
GOOGLE_SHEETS_CLIENT_SECRET=

# Google Gemini Chat Model nodes: Google Gemini / Google AI Studio API credential
GOOGLE_GEMINI_API_KEY=
